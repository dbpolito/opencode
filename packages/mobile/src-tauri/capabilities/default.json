{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "platforms": ["iOS"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "process:default",
    "store:default",
    "os:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "http://*:*/*" }]
    }
  ]
}
